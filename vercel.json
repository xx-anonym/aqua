{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)catalog-images' ':(exclude)data-pipeline' ':(exclude)*.md'",
  "rewrites": [
    {
      "source": "/catalog/img/:path*",
      "destination": "https://aqua-katalog.vercel.app/img/:path*"
    },
    {
      "source": "/catalog/thumb/:path*",
      "destination": "https://aqua-katalog.vercel.app/thumb/:path*"
    },
    {
      "source": "/((?!api/|assets/|catalog/|icons/|sw\\.js|workbox-|manifest\\.webmanifest|registerSW\\.js|version\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/catalog/(img|thumb)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(sw\\.js|registerSW\\.js|manifest\\.webmanifest|version\\.json|catalog/catalog\\.sqlite|catalog/catalog-manifest\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/keepalive",
      "schedule": "17 16 * * *"
    }
  ]
}
